# =============================================================================
# Monee — biến môi trường cho deploy (Supabase + Cloudflare Pages)
#
# CÁCH DÙNG (chọn 1 trong 2):
#   A. Khuyên dùng: copy các dòng dưới vào Environment variables của
#      Claude Code trên web (claude.ai/code → Settings → Environments →
#      environment của repo này) rồi mở phiên mới, nhắn "Deploy đi".
#   B. Hoặc: `cp .env.deploy.example .env.deploy` rồi điền giá trị thật.
#      File `.env.deploy` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit nó.
#
# Mỗi giá trị lấy ở đâu — xem chú thích từng biến bên dưới.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Tạo tại: https://supabase.com/dashboard/account/tokens → Generate new token
# Dùng để: tạo project, chạy migration (db push), deploy 5 Edge Functions,
# lấy URL + publishable key cho app.
SUPABASE_ACCESS_TOKEN=sbp_54a0d4cd6cfa1ebe048a56708723957bfa530c03

# Mật khẩu database cho project mới (tự đặt, >= 16 ký tự, có chữ hoa/thường/số).
# Bỏ trống thì Claude tự sinh ngẫu nhiên và báo lại cho bạn lưu.
SUPABASE_DB_PASSWORD=

# --- Plaid -------------------------------------------------------------------
# Lấy tại: https://dashboard.plaid.com → Developers → Keys
# client_id dùng chung mọi môi trường; secret riêng theo môi trường.
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# sandbox = bank giả để test flow (secret Sandbox ở trên cùng trang Keys)
# production = bank thật (cần được Plaid duyệt Production/Limited Production
# trước — đổi PLAID_SECRET sang Production secret khi chuyển)
PLAID_ENV=sandbox

# --- Cloudflare Pages --------------------------------------------------------
# Account ID: https://dash.cloudflare.com → Overview → thanh bên phải
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Token: dash.cloudflare.com → My Profile → API Tokens → Create Token
# → template "Edit Cloudflare Workers" (đủ quyền cho Pages),
#   hoặc Custom token với permission: Account → Cloudflare Pages → Edit
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Tự sinh khi deploy (KHÔNG cần điền) --------------------------------------
# CRON_SECRET       — Claude sinh ngẫu nhiên, set vào Edge Functions + cron SQL
# SUPABASE_URL      — có sau khi tạo project (dạng https://<ref>.supabase.co)
# SUPABASE_ANON_KEY — publishable key, lấy từ dashboard sau khi tạo project;
#                     hai giá trị này đưa vào app qua --dart-define lúc build web
